/** Human readable report. This is not consumed by boulder */
{
	"manifest-version": "0.2",
	"packages": {
		"cargo-update": {
			"build-depends": [
				"binary(bsdtar-static)",
				"pkgconfig(libcurl)",
				"pkgconfig(libgit2)",
				"pkgconfig(libssh2)",
				"pkgconfig(openssl)"
			],
			"depends": [
				"binary(cargo)",
				"interpreter(/usr/lib/ld-linux-x86-64.so.2(x86_64))",
				"soname(ld-linux-x86-64.so.2(x86_64))",
				"soname(libc.so.6(x86_64))",
				"soname(libcurl.so.4(x86_64))",
				"soname(libgcc_s.so.1(x86_64))",
				"soname(libgit2.so.1.9(x86_64))",
				"soname(libssl.so.4(x86_64))"
			],
			"files": [
				"/usr/bin/cargo-install-update",
				"/usr/bin/cargo-install-update-config",
				"/usr/share/licenses/cargo-update/LICENSE"
			],
			"name": "cargo-update",
			"provides": [
				"binary(cargo-install-update)",
				"binary(cargo-install-update-config)"
			]
		}
	},
	"source-name": "cargo-update",
	"source-release": "1",
	"source-version": "22.1.1"
}
